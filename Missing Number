
import java.util.*;
class Main {
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();       
        int sums = 0;
    for(int i = 0;i<n;i++){
        sums += sc.nextInt();
    }
        int expected = (n*(n+1))/2;
        int missing = expected - sums;
        System.out.println(missing);
    
            
}
}


    
